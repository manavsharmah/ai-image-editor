{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  // Becomes ai-image-editor.<your-subdomain>.workers.dev
  "name": "ai-image-editor",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    // Relative to this config file. Everything in this folder is public.
    "directory": "../web",
    // /api/* always goes to Hono; other paths try a static file first.
    "run_worker_first": ["/api/*"]
  },
  // Workers AI (free daily allocation only; no paid plan). Used by POST /api/look.
  // AI always runs on Cloudflare, even in `wrangler dev` (needs login there).
  "ai": { "binding": "AI", "remote": true },
  // Per-IP limit for POST /api/look. Approximate, and counted separately in
  // each Cloudflare location. namespace_id must be unique in the account.
  "ratelimits": [
    {
      "name": "LOOK_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 }
    }
  ]
}
